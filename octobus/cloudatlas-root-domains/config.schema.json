{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "spaceId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  },
  "required": [
    "baseUrl",
    "spaceId"
  ]
}
