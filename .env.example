# Local development defaults. Copy to .env and replace every placeholder for deployment.
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME=Exposure-Agent
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
TEST_API_URL=http://localhost:8000

# Security-sensitive placeholders; production startup rejects these repository defaults.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Local image names and host storage
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
DOCKER_IMAGE_OCTOBUS=octobus
DOCKER_IMAGE_RUNNER=governance-runner
ARTIFACT_HOST_PATH=/tmp/exposure-agent-artifacts
TAG=latest

# Replace both tokens for every deployment. The CloudAtlas token must be read-only.
AGENT_COMPOSE_AUTH_TOKEN=
# agent-compose v2608.4.0, upstream revision 5df1acb0cda4159f7106f263e358c8a84026a142.
AGENT_COMPOSE_RUNTIME_VERSION=sha256:092f8c4fbf7254ddd200a36d99ae6583cd08f5ddeda9cafd559b3636890c9670
CLOUDATLAS_CAPSET_TOKEN=
RUNNER_BUILD_VERSION=development

# Customer-controlled OpenAI-compatible model used only through Pi.
MODEL_API_ENDPOINT=http://model.internal/v1
MODEL_API_PROTOCOL=chat_completions
MODEL_API_KEY=
MODEL_IDENTITY=customer-model
# Increment when any non-secret inference configuration changes.
MODEL_CONFIG_REVISION=v1
MODEL_QUALIFICATION_TIMEOUT_SECONDS=120
