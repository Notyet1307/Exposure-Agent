FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global --ignore-scripts @chaitin-ai/octobus@0.1.0

COPY tests/cloudatlas_fixture/fake-chaitin-cli.js /usr/local/bin/chaitin-cli
RUN chmod 0555 /usr/local/bin/chaitin-cli

ENTRYPOINT ["octobus"]
