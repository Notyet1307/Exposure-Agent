# Local development can call the directly exposed backend; deployed browsers use Nginx /api.
FRONTEND_HOST=http://localhost:5173

ENVIRONMENT=local

PROJECT_NAME=Exposure-Agent

BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
TEST_API_URL=http://localhost:8000
SECRET_KEY=not-for-production-issue4-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=not-for-production-issue4-admin

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=not-for-production-issue4-postgres

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
DOCKER_IMAGE_OCTOBUS=octobus
DOCKER_IMAGE_RUNNER=governance-runner
ARTIFACT_HOST_PATH=/tmp/exposure-agent-artifacts
TAG=latest

# agent-compose owns Governance Runner Session lifecycle. Replace these local
# values for every deployment and keep the CloudAtlas Capset token out of
# PostgreSQL and application audit records.
AGENT_COMPOSE_AUTH_TOKEN=not-for-production-agent-compose-token
CLOUDATLAS_CAPSET_TOKEN=fixture-capset-token
RUNNER_BUILD_VERSION=development
