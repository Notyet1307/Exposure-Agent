FROM python:3.14-bookworm AS python-runtime

# Pin the multi-architecture manifest, not the arm64-only image manifest.
# GitHub Actions builds on amd64 while local development may use arm64.
FROM chaitin/agent-compose-guest@sha256:a016062c336a4c3e7ddd863a0c3ed698159655d80966b900585ecb2a67ea0740

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=python-runtime /usr/local /usr/local
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

# Qualification runs have no tool capability; the governance runner uses a
# direct command and is unaffected by the Pi wrapper.
RUN mv /usr/bin/pi /usr/bin/pi-with-tools && \
    printf '%s\n' '#!/bin/sh' \
    'config_dir=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}' \
    'mkdir -p "$config_dir"' \
    'printf '\''%s\n'\'' '\''{"retry":{"enabled":false,"provider":{"maxRetries":0}}}'\'' > "$config_dir/settings.json"' \
    'exec /usr/bin/pi-with-tools --no-tools "$@"' \
    > /usr/bin/pi && chmod 0755 /usr/bin/pi

WORKDIR /app/

ARG RUNNER_BUILD_VERSION=development
RUN test -n "$RUNNER_BUILD_VERSION" && printf '%s\n' "$RUNNER_BUILD_VERSION" > /app/runner-build-version

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-workspace --package app

COPY ./backend/pyproject.toml ./backend/alembic.ini /app/backend/
COPY ./backend/app /app/backend/app

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --package app

RUN mkdir -p /app/artifacts /workspace /data/state /data/runtime /data/logs

WORKDIR /workspace
